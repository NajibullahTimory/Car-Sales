# تنظیمات Backend؛ رمز واقعی را فقط در فایل محلی .env بنویسید.
PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/motrly_vehicle_market
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://127.0.0.1:5000,http://localhost:5000
PGSSL=false

# حساب مدیر هنگام اجرای npm run seed ساخته می‌شود.
OWNER_USERNAME=your_owner_username
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=choose-a-private-password
